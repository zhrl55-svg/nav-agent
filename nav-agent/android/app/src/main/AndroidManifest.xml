<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_LOCATION_EXTRA_COMMANDS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      蓝牙自动启动：连上车机后自动拉起语音服务。

      Android 12（API 31）起蓝牙权限拆成了运行时权限：
        BLUETOOTH_CONNECT —— 读设备名、收连接广播（**必需**）
        BLUETOOTH_SCAN    —— 扫描设备（这里不主动扫，但部分 ROM 要求一起给）

      maxSdkVersion=30 是给 Android 11 及以下的旧权限用的，
      31+ 系统不认这两个，必须用 BLUETOOTH_CONNECT。
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <!--
      Android 11+ 的包可见性：不声明 queries 就 getPackageInfo 不到别的应用，
      会把已装的 TTS 引擎（com.iflytek.speechsuite）误判成"没装"。
      实测就是这么回退到华为引擎的。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!--
      usesCleartextTraffic：允许明文 HTTP。

      ★ 2026-11-02 加。对话大脑现在可以接本地模型，地址形如
        `http://192.168.1.100:1234/v1`（LM Studio）/ `:11434/v1`（Ollama）。
        Android 9+ 默认禁止明文 HTTP，不开这个开关，请求会直接抛
        `Cleartext HTTP traffic not permitted` —— 现象是"接上本地模型之后它不说话"，
        而且这个异常只在日志里出现一次，极难联想。

      代价说明：这意味着全 App 都允许 http://。对本项目可以接受 ——
      默认走的是 https 的官方接口，明文只会在用户自己填局域网地址时用到。
    -->
    <application
        android:name=".NavApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.NavAgent">

        <!-- 高德 Key：包名 com.navagent，绑定 android-nav -->
        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="${AMAP_KEY}" />

        <!--
          高德定位的辅助服务。
          navi-3dmap 是纯 jar（不是 aar），它的 manifest 不会被合并，
          而它内置的 com.amap.api.location.AMapLocationClient 启动时会尝试拉起这个服务。
          不声明就会在 logcat 里看到：
            Unable to start service Intent { cmp=com.navagent/com.amap.api.location.APSService } not found
          并导致定位能力退化。必须手动补上。
        -->
        <service
            android:name="com.amap.api.location.APSService"
            android:enabled="true"
            android:exported="false" />

        <!--
          主界面：导航页。2026-11-01 起改为单界面架构 —— 全程语音，
          不再有专门的聊天界面，导航页就是唯一的操作面。

          为什么主界面是导航页而不是聊天页：
          用户明确要求「直接不要聊天界面，聊天全程语音」。
          导航页本来就有地图、语音按钮和输入框，功能是聊天页的超集。

          LAUNCHER 只能有一个，所以 ChatActivity 那边移掉了 intent-filter。

          clearTaskOnLaunch：每次从桌面点图标都清空任务栈，只留这一页。
          没有它的话，用户上次停在对话页、按 Home 再点图标，Android 会恢复
          任务栈顶层 —— 也就是又看到对话页。用户明确要求「打开 App 默认
          不要停在对话页」，所以这里强制回到导航页。
          注意它只影响"从桌面启动"这一刻，应用内导航页 ↔ 对话页的往返
          （REORDER_TO_FRONT 保留实例）不受影响。
        -->
        <activity
            android:name=".NavActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:clearTaskOnLaunch="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          聊天页：保留但不可见（2026-11-01 起不再是主界面）。

          为什么留着不删：
          万一用户想看历史对话、或者语音识别不准想打字核对，
          还能从导航页进得来。纯语音模式出问题就没有退路了。

          它没有 LAUNCHER intent-filter，所以桌面点图标不会进这个页面。
        -->
        <activity
            android:name=".ChatActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- 设置页：唤醒词 / 模型 / 播报 / 诊断 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- 语音常驻：麦克风唯一持有者。息屏也要能听见唤醒词 -->
        <service
            android:name=".VoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone|location" />

    </application>

</manifest>
