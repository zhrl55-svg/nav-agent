<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- AMapNaviView 当画布用。内置 UI 默认开着（Prefs.amapBuiltinUi），
         由代码里的 setCrossLocation 限制在「状态栏下方 → 底部面板上方」这块区域。 -->
    <com.amap.api.navi.AMapNaviView
        android:id="@+id/navi_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
      退出应用按钮（左上角）。

      ★ 2026-11-04 加回来。
        之前撤掉是因为底部高德 footer 里也有个「退出」——
        但那两个根本不是一回事：
          我们的 = 退出整个 app（停导航 + 停语音服务 + 杀进程）
          高德的 = 只退出导航，app 还活着，语音还在后台听着麦克风。
        用户要的是真能退出 app 的那个，不能被高德的顶替。

      ★ 底色跟侧边按钮统一（灰色圆形），跟整排控件是一套。
    -->
    <LinearLayout
        android:id="@+id/exit_nav"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_side_btn"
        android:clickable="true"
        android:contentDescription="@string/nav_exit_desc"
        android:elevation="6dp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- 顶部 HUD：转向箭头 + 距离 + 路名 + 全程剩余。
         ★ 只在**关闭**高德内置界面时才画（内置界面开着时由高德画转向信息，
           两套叠一起会重影）。
         ★ marginStart 从 64dp 改回 10dp：原来那 64dp 是给左上角退出按钮让位的，
           退出按钮 2026-11-04 已撤掉，不用再留空。 -->
    <LinearLayout
        android:id="@+id/hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_card"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/hud_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/hud_icon_desc"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hud_step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E6EDF5"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hud_road"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#B8CDE0"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/hud_remain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#8FA8C0"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!--
      顶部工具条：地址搜索 + 导航信号。

      ★ 2026-11-04 重排。原来还有一颗退出按钮，但底部底框取消之后，
        高德内置的 footer（退出 / 剩余距离 / 剩余时间）会露出来 ——
        那个「退出」在高德自己的导航流程里更完整（会弹二次确认），
        所以我们的退出按钮撤掉，避免两个「退出」让用户不知道按哪个。

      ★ 2026-11-04 再改：搜索栏从「屏幕顶部」挪到「高德转向条下方」。
        原来它压在转向条上面，转向箭头被挡掉一半 ——
        转向箭头是开车时最该看的一眼，不能被搜索框压住。
        具体位置在代码里运行时算（见 positionSearchBelowBanner），
        因为转向条高度不固定。

      ★ 底色用 bg_input_translucent（半透明灰）：
        压在地图上的控件不透明就是一块补丁，半透明才像「浮在地图上」。
    -->
    <LinearLayout
        android:id="@+id/top_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

<!--
          地址搜索栏。点击进入输入，回车或停顿自动搜。

          ★ 2026-11-04：位置跟着高德的「中间信息区」**同一行**（middle_layout）。
            原来在屏幕顶部，压着转向箭头 —— 转向箭头是开车时最该看的一眼。
            挪到 middle_layout 之后，中间信息区（限速牌那层）就完整露出来了。

          ★ 居中（2026-11-04）：用户要求不要靠右。
            限速牌在中间信息区的左边，全程按钮在右边，
            搜索栏放中间不跟任何一边打架。

          ★ 宽度不占满：用 maxWidth 限制。
            （不能用百分比 —— LinearLayout 的 layout_width 不支持 %，
              也不能用 weight，那会重新占满整行。）
        -->
        <LinearLayout
            android:id="@+id/search_box"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:maxWidth="200dp"
            android:background="@drawable/bg_input_translucent"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3">

            <ImageView
                android:id="@+id/search_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/search_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:autofillHints=""
                android:background="@null"
                android:hint="@string/nav_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:minWidth="60dp"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:textColor="#FFFFFF"
                android:textColorHint="#C8D2DC"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/search_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                android:text="✕"
                android:textColor="#8FA8C0"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>

        <!--
          导航信号指示。

          ★ 2026-11-04 恢复显示（用户：「不要纠结导航信号的显示与否，
            如果它能及时刷新，就让他显示」）。

          ★ 为什么能及时刷新：
            我们每秒轮询一次 nav.signalLevel()（看定位时间戳 + SDK 信号等级），
            颜色和文字都跟着变 —— 不是高德内置那个**静态**的「卫星信号弱」
            （进了弱信号就一直挂着不恢复，用户投诉过）。
            高德内置那个已经被 removeView + 尺寸清零干掉了。

          ★ 位置：搜索栏**正下方**，跟着搜索栏一起跑。
            放屏幕顶部居中会被高德的转向条盖住（实测只剩半截）；
            放这里刚好在「转向条 → 搜索栏 → 信号指示」的视觉流里，
            而且限速牌在搜索栏左侧，不打架。

          ★ 只留文字 + 阴影（2026-11-04 统一过配色）。
            颜色区分状态：绿=信号好 / 黄=信号弱 / 红=无信号 / 灰=定位中。
        -->
        <TextView
            android:id="@+id/gps_signal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:minWidth="58dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="定位中"
            android:textColor="#8FA8C0"
            android:textSize="12sp" />

        <!--
          搜索结果浮层。

          放在搜索栏下方的同一列里，位置天然跟着搜索栏走，不用算偏移。
          默认 gone，搜索有结果才显示；点空白处或选中后收起。

          ★ 宽度 220dp（比搜索栏宽，但不能太宽）：
            搜索栏只有 150dp，候选列表要显示「名称 + 地址」两行，太窄会挤成一团；
            但也不能太宽 —— 会压住右侧的「历史/对话」按钮（实测 280dp 就压住了）。

          ★ 外层必须是 ScrollView：键盘弹出后可用高度只剩一半，
            结果列表会顶到屏幕外面（实测第 5 条就被键盘盖住了）。
            高度上限在代码里按屏幕比例设（见 setupSearchBar）。
        -->
        <ScrollView
            android:id="@+id/search_results_scroll"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card"
            android:clipToOutline="true"
            android:elevation="8dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/search_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="4dp" />
        </ScrollView>
    </LinearLayout>

    <!--
      导航信号指示 —— 已移除（2026-11-04）。

      ★ 为什么整个删掉：
        ① 高德内置的那个「卫星信号弱」是静态的，进了弱信号就一直挂着不恢复，
           而且它跟我们的胶囊位置完全重叠（850~1146, 237~299），
           两个叠一起像一串乱码。
        ② 高德那个怎么都关不掉：
           getIdentifier 查不到（jar 资源合并进我们 R 表）、setGPSViewVisible 调了没用
           （SDK 每次 updateNaviInfo 都设回 VISIBLE）、
           只能 removeView —— 但那属于跟 SDK 硬扛，代价大收益小。
        ③ 用户反馈「信号可以不要」。

      信号弱了地图自己会有反应（定位漂移、转向提示延迟），
      语音播报也会照常继续 —— 不需要额外的 UI 提醒。

      搜索栏的输入文字颜色见下面 search_input（改成高对比的白色 + 阴影）。
    -->

        <!--
      左侧按钮列：上 = 语音，中 = 导航播报模式，下 = 设置。

      ★ 为什么竖排在左侧而不是底部一行：
        底部要留给高德自己的 footer（退出 / 剩余距离 / 剩余时间），
        我们的按钮再压上去就是两层叠一起，全都点不准。
        左侧竖排贴着屏幕边，不占中间的地图。

      ★ 语音按钮右边跟识别文本：
        识别到的原文（「导航去西站」）必须能一眼看到 ——
        纯语音界面没有消息列表，听错了用户无从发现。
        跟在语音按钮右侧，喊完话余光就能扫到，2 秒后自动消失。
    -->
    <!--
      导航中的目的地条。

      ★ 2026-11-08 用户反馈：「导航页没有一个地方显示目的地」。
        高德内置界面底部只有 距离 / 时间 / 限速 / 到达时间，全程看不到在往哪开。

      ★ 为什么放在这个位置（占掉 SDK「当前道路」条的地方）：
        那块显示「非机动车道」，而转向卡片里同一句已经有了，属于重复信息；
        目的地名字反而是全程缺失的。所以让路名条让位（代码里一并隐藏）。
    -->
    <TextView
        android:id="@+id/nav_destination"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="76dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_dest_chip"
        android:elevation="6dp"
        android:ellipsize="end"
        android:maxWidth="320dp"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/side_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="left|center_vertical"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!--
              ★ 用 LinearLayout + ImageView，不用 Button 的 drawableStart。
                Button 的「图标+文字」组合居中不可控：实测 paddingStart=0 之后
                左边留白 1dp、右边 8dp，整体明显偏左。

              ★ 2026-11-04：**只留图标**，去掉「语音」文字。
                按钮缩成 46×46 的圆形小按钮，不占横向空间，
                地图露出来的面积更大。状态靠图标表达：
                  麦克风 = 待命 / 聆听中（按一下说话）
                  喇叭   = TTS 播报中（它在说话）
            -->
            <LinearLayout
                android:id="@+id/talk"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_side_btn"
                android:clickable="true"
                android:elevation="6dp"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/talk_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/voice"
                    android:src="@drawable/ic_mic_active" />
            </LinearLayout>

            <!--
              识别到的文字。跟着语音按钮右侧，2 秒后自动消失。

              ★ 为什么要自动消失：它只是「机器听成了什么」的瞬时确认，
                一直挂着会挡地图；2 秒足够用户读完并发现「哎说错了」，
                之后注意力就该回到路上了。

              ★ 2026-11-04：颜色改白色、字号加大到 15sp。
                原来蓝色 13sp 在浅色地图上不够醒目 —— 用户得眯着眼才看得清
                机器听成了什么，而这一眼恰恰是纠错的关键。
                白色 + 稍大字号，在任何底色的地图上都清晰。
            -->
            <TextView
                android:id="@+id/recognized"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_status_chip"
                android:ellipsize="end"
                android:elevation="6dp"
                android:maxLines="1"
                android:maxWidth="190dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!--
          导航播报模式。点击按「详细 → 标准 → 简洁 → 关闭」循环切换。
          文字直接显示当前模式，开车时不用进设置页，也不用记图标含义。
        -->
        <TextView
            android:id="@+id/nav_voice_mode"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_side_btn"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="详细"
            android:textColor="#F0F2F5"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!--
          设置按钮（齿轮图标）。

          ★ 2026-11-04：文字「设置」改成齿轮图标。
            跟语音按钮一样是 46×46 的纯图标圆形按钮，
            一排图标在侧边更整齐，也少占横向空间。
            齿轮是设置的国际通用符号，不用认字。
        -->
        <LinearLayout
            android:id="@+id/nav_settings"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_side_btn"
            android:clickable="true"
            android:contentDescription="@string/settings"
            android:elevation="6dp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_settings" />
        </LinearLayout>
    </LinearLayout>

    <!--
      右侧按钮列：上 = 全程（路线图图标），中 = 历史，下 = 对话。

      ★ 「全程」放最上面（2026-11-04）：
        导航中最常用的操作 —— 看一眼整条路线有多长、往哪走。
        放最上面手最好点，也最不容易跟高德自己的按钮撞。
        没在导航时隐藏（没有路线，全程也没意义）。

      ★ 「历史」看最近去过的目的地，「对话」进聊天页看消息记录。
    -->
    <LinearLayout
        android:id="@+id/side_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right|center_vertical"
        android:layout_marginEnd="12dp"
        android:orientation="vertical">

        <!--
          全程预览按钮（路线图图标）。

          ★ 46×46 圆形，跟左边的语音/齿轮同一套规格。
            点一下在「全程」和「当前位置」之间切换 ——
            跟高德 App 的行为一致，第二次点回到跟随视角。
        -->
        <LinearLayout
            android:id="@+id/route_overview"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_side_btn"
            android:clickable="true"
            android:contentDescription="@string/route_overview_desc"
            android:elevation="6dp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/route_overview_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_route_overview" />
        </LinearLayout>

        <TextView
            android:id="@+id/history_nav"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_side_pill"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="历史"
            android:textColor="#F0F2F5"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/back_to_chat"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_side_pill"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="对话"
            android:textColor="#F0F2F5"
            android:textSize="13sp" />
    </LinearLayout>

</FrameLayout>
