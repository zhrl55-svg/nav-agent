<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- AMapNaviView 当画布用。内置 UI 默认开着（Prefs.amapBuiltinUi），
         由代码里的 setCrossLocation 限制在「状态栏下方 → 底部面板上方」这块区域。 -->
    <com.amap.api.navi.AMapNaviView
        android:id="@+id/navi_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部 HUD：转向箭头 + 距离 + 路名 + 全程剩余。
         ★ marginStart 让开左上角退出按钮（按钮 48dp + 左右各 8dp = 64dp），
           否则 HUD 卡片会压住按钮，两个都点不准。 -->
    <LinearLayout
        android:id="@+id/hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="64dp"
        android:background="@drawable/bg_card"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/hud_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/hud_icon_desc"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hud_step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E6EDF5"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hud_road"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#B8CDE0"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/hud_remain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#8FA8C0"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!--
      左上角退出按钮 —— 退出**整个应用**，不是退出导航。

      ★ 为什么需要它：高德内置界面的底栏（退出 / 继续导航 / 设置）被
        setCrossLocation 裁到了屏幕外 —— 我们把底部让给了自己的面板，
        官方那个「退出」就跟着没了。不给一个显式入口，用户只能靠系统返回键，
        车机上（尤其车机把返回键收进菜单）等于没有出口。

      位置：贴状态栏下方、左边 8dp。topMargin 在代码里按状态栏实际高度设，
            写死 12dp 在刘海屏上会被状态栏压掉。
      z 序：放在 HUD 之后 → 盖在 HUD 和地图上面。
    -->
    <ImageButton
        android:id="@+id/exit_nav"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="8dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_nav_exit"
        android:contentDescription="@string/nav_exit_desc"
        android:elevation="6dp"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close" />

    <!-- 底部：状态 + 输入框 + 按钮。
         导航中唤醒聊天，回答不切页面 —— 地图不能离开视野，开车时也不看屏，主要靠 TTS。
         输入框是为了不用说话也能发指令（旁边有人、或者语音识别不准的时候）。
         ★ 导航页不显示聊天内容（气泡浮层已移除），只在状态行显示一行提示。 -->
    <LinearLayout
        android:id="@+id/bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#E6101820"
        android:elevation="10dp"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hint_idle"
            android:textColor="#E6EDF5"
            android:textSize="14sp" />

        <!--
          识别到的文字（临时提示）。

          ★ 需求：输入框上方显示每次识别成功的文字，发送后自动消失。
            纯语音界面没有消息列表，用户看不到「机器到底听成了什么」——
            识别错了就无从发现（「导航去西站」被听成「导航去西战」，用户根本不知道）。
            这里显示一次，让人能立刻确认或用输入框改。

          生命周期：识别成功 → 显示 → 发送后清空。
            不用聊天气泡那套（气泡会把整段历史都留在屏幕上，开车时干扰视线）。
        -->
        <TextView
            android:id="@+id/recognized"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#7FB2DC"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- 打字发指令 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/input"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:autofillHints=""
                android:background="@drawable/bg_input"
                android:hint="@string/chat_hint"
                android:imeOptions="actionSend"
                android:inputType="text"
                android:maxLines="2"
                android:paddingHorizontal="14dp"
                android:textColor="#E6EDF5"
                android:textColorHint="#5A6E82"
                android:textSize="14sp" />

            <Button
                android:id="@+id/send"
                android:layout_width="64dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_input"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                android:text="@string/send"
                android:textColor="#E6EDF5"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 五个按钮等宽，别让任何一个被挤掉。
             「对话」进隐藏的 ChatActivity（看历史消息用），
             「设置」进设置页 —— 2026-11-01 起设置入口从聊天页搬到了这里，
             因为聊天页不再是主界面。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <!--
              ★ 用 LinearLayout + ImageView + TextView，不用 Button 的 drawableStart。
                Button 的「图标+文字」组合居中不可控：实测 paddingStart=0 之后
                左边留白 1dp、右边 8dp，整体明显偏左，图标和文字之间也松。
                自己排就能把间距压到 3dp，并且真正居中。
            -->
            <LinearLayout
                android:id="@+id/talk"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/talk_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_mic" />

                <TextView
                    android:id="@+id/talk_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:includeFontPadding="false"
                    android:text="语音"
                    android:textColor="#E6EDF5"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/stop_nav"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                android:text="@string/nav_stop"
                android:textColor="#E6EDF5"
                android:textSize="13sp" />

            <Button
                android:id="@+id/history_nav"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                android:text="历史"
                android:textColor="#E6EDF5"
                android:textSize="13sp" />

            <Button
                android:id="@+id/back_to_chat"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                android:text="对话"
                android:textColor="#E6EDF5"
                android:textSize="13sp" />

            <Button
                android:id="@+id/nav_settings"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                android:text="设置"
                android:textColor="#E6EDF5"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
