<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101820"
    android:orientation="vertical">

    <!-- 顶栏：名字 + 语音状态 + 设置入口 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#182430"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ai_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_title"
                android:textColor="#E6EDF5"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/voice_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/chat_subtitle"
                android:textColor="#8FA8C0"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/interrupt_nav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_btn_danger"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:text="中断"
            android:textColor="#F2E4E4"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/open_nav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:text="@string/open_nav"
            android:textColor="#7FB2DC"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:text="@string/settings"
            android:textColor="#8FA8C0"
            android:textSize="14sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#182430"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <EditText
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="@string/chat_hint"
            android:imeOptions="actionSend"
            android:inputType="text"
            android:maxLines="3"
            android:paddingHorizontal="16dp"
            android:textColor="#E6EDF5"
            android:textColorHint="#5A6E82"
            android:textSize="15sp"
            android:autofillHints="" />

        <Button
            android:id="@+id/mic"
            android:layout_width="64dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_primary"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
            android:text="◉ 语音"
            android:textColor="#0E1620"
            android:textSize="13sp" />

        <Button
            android:id="@+id/send"
            android:layout_width="64dp"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_btn_ghost"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
            android:text="@string/send"
            android:textColor="#E6EDF5"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
