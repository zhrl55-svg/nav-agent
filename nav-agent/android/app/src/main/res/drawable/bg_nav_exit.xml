<?xml version="1.0" encoding="utf-8"?>
<!--
  导航页左上角退出按钮的底。

  ★ 必须比高德顶部条**亮一档**：卡片是 #E60E1620 那种深蓝灰，
    按钮再用同色就完全融进卡片里，压在转向箭头上看起来像卡片缺了一块。
    这里用 #E62B3B4D + 更亮的描边，让它明显是「浮在上面的独立控件」。

  ★ 不透明度 90%：地图走到浅色区域（白天、大片水面）时，
    太透会看不清白色 ×；太实又挡住底下的转向箭头。
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E62B3B4D" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#4E7291" />
        </shape>
    </item>
</ripple>
