<?xml version="1.0" encoding="utf-8"?>
<!--
  聆听态按钮（浅灰底 + 蓝描边）。

  ★ 底色跟常态按钮一致（bg_side_btn 的浅灰 #99666F78），
    聆听态只靠**描边颜色 + 外圈**区分状态 ——
    蓝色描边在浅灰底上照样醒目，而且不会出现「一排浅色按钮里跳出一个深底」。

  ★ 外圈用负 inset 撑出边框，不改变按钮本身的尺寸和位置。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外圈：淡蓝描边 + 半透明填充，做「声波环」的呼吸效果 -->
    <item android:left="-4dp" android:top="-4dp" android:right="-4dp" android:bottom="-4dp">
        <shape android:shape="rectangle">
            <solid android:color="#334A7BA7" />
            <corners android:radius="26dp" />
            <stroke
                android:width="2dp"
                android:color="#8FB6D8" />
        </shape>
    </item>
    <!-- 底层：和常态按钮同一个浅灰 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#99666F78" />
            <corners android:radius="23dp" />
            <stroke
                android:width="1.5dp"
                android:color="#A8BBD0" />
        </shape>
    </item>
</layer-list>
