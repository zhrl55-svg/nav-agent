<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 底层声波环，通过 alpha 呼吸，不改变按钮尺寸与位置 -->
    <item android:left="-5dp" android:top="-5dp" android:right="-5dp" android:bottom="-5dp">
        <shape android:shape="rectangle">
            <solid android:color="#224A7BA7" />
            <corners android:radius="18dp" />
            <stroke android:width="2dp" android:color="#6B9CC8" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#5B8FC9" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#B7D8F3" />
        </shape>
    </item>
</layer-list>
