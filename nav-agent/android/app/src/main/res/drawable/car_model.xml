<?xml version="1.0" encoding="utf-8"?>
<!--
  导航页的车辆模型（替换 SDK 默认的蓝色箭头）。

  为什么要换：SDK 默认画的是个蓝色三角箭头（像地图上的定位针），
  而高德 App 本体画的是**俯视的汽车模型**（白色车身 + 深色车窗 + 尾翼），
  视觉上完全是两个东西 —— 用户对比 HiCar 时觉得"不像"的主要来源之一。

  画法：俯视视角的汽车轮廓。
    车头朝上（导航时车头指向行进方向）。
    中间深色是前挡风玻璃 + 车顶，下方是后挡风。
    底下两个深色小块是后轮。

  尺寸按 48x48 设计，SDK 会自己缩放。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- 车身主体 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M24,3 C29.5,3 33,7.5 33.5,13 L34.5,30 C34.7,35.5 30.5,39 24,39 C17.5,39 13.3,35.5 13.5,30 L14.5,13 C15,7.5 18.5,3 24,3 Z" />

    <!-- 前挡风玻璃（深色） -->
    <path
        android:fillColor="#3A4A5A"
        android:pathData="M19.5,13 L28.5,13 L29.5,20 L18.5,20 Z" />

    <!-- 车顶 / 后挡风 -->
    <path
        android:fillColor="#2A3A4A"
        android:pathData="M19,22.5 L29,22.5 L29.8,29 L18.2,29 Z" />

    <!-- 后挡风 -->
    <path
        android:fillColor="#3A4A5A"
        android:pathData="M18.8,31 L29.2,31 L29.6,35 L18.4,35 Z" />

    <!-- 左右后轮 -->
    <path
        android:fillColor="#2A3A4A"
        android:pathData="M13.2,25 L16.2,25 L16.4,33 L13.4,33 Z" />
    <path
        android:fillColor="#2A3A4A"
        android:pathData="M31.8,25 L34.8,25 L34.6,33 L31.6,33 Z" />

    <!-- 车头灯 -->
    <path
        android:fillColor="#FFE9A8"
        android:pathData="M20,5.5 L22.5,5 L22.5,8 L20,8.5 Z" />
    <path
        android:fillColor="#FFE9A8"
        android:pathData="M28,5 L30.5,5.5 L30,8.5 L27.5,8 Z" />

    <!-- 尾灯 -->
    <path
        android:fillColor="#E86A6A"
        android:pathData="M20,37 L28,37 L28,38.5 L20,38.5 Z" />
</vector>
