<?xml version="1.0" encoding="utf-8"?>
<!--
  未导航时地图中心的方向箭头。

  ★ 为什么不直接用 SDK 自带的定位蓝点：
    蓝点是个圆，看不出车头朝哪；开车时最需要的恰恰是"我朝哪边"。
    这里画一个朝上的箭头，配合 MyLocationStyle 的
    LOCATION_TYPE_LOCATION_ROTATE_NO_CENTER，箭头会跟着设备方向转。

  白色外轮廓 + 蓝色内芯：深色地图上纯蓝容易糊进背景，
  加一圈白边在任何底图上都看得清（高德自己的车标也是这么处理的）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,1.2 L21.8,22.4 L12,17.6 L2.2,22.4 Z" />

    <path
        android:fillColor="#2E8BE6"
        android:pathData="M12,4.6 L19.2,19.6 L12,16 L4.8,19.6 Z" />
</vector>
