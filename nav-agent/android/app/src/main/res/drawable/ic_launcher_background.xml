<?xml version="1.0" encoding="utf-8"?>
<!--
  应用图标的背景层：蓝灰渐变方框。

  配色跟应用界面统一（底 #101820 / 强调 #4A7BA7 / 高亮 #7FB2DC），
  这样桌面图标和打开后的界面是同一套色。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#1B3040" />
                <item android:offset="1" android:color="#0E1620" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
