<?xml version="1.0" encoding="utf-8"?>
<!--
  应用图标的背景层：亮蓝灰渐变方框。

  ★ 为什么不用应用界面那套深色（#101820 / #0E1620）：
    桌面壁纸通常也是深色的，图标底色太深会跟壁纸糊在一起，
    整个图标看起来就是一块黑 —— 用户反馈「底色也太深了」。

    所以这里单独调亮，用中蓝到亮蓝的渐变，
    跟深色壁纸拉开对比。图标跟应用界面不必完全同色，
    图标要的是「在桌面上能一眼找到」。

  配色：#5B9BD5（亮）→ #2F6FA8（深），箭头用纯白。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#6BAEE0" />
                <item android:offset="1" android:color="#2F6FA8" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
