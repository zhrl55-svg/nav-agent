<?xml version="1.0" encoding="utf-8"?>
<!--
  应用图标的前景层：朝上的定位箭头（Navigation Arrow）。

  ★ 为什么不用「折角」造型：
    折角（像一张翻起来的地图）本身就有立体方块的感觉，
    再叠加 EMUI 对自适应图标前景的立体化处理，整个图标就变成了立方体 ——
    用户一眼看不出是导航 app（实测踩过）。

  改成最经典、最高度可辨识的「纸飞机式定位箭头」：
    一个尖朝上的水滴箭头 + 中间的圆孔，一眼就知道是导航/定位。

  坐标按 108x108 设计。自适应图标的安全区是中间 72x108，
  实际可见约 66x66，所以图形要留够边距，别贴边。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 箭头主体：尖朝上，底边圆润的水滴形 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,30 C54,30 75,51 75,65 C75,76.5 65.6,85 54,85 C42.4,85 33,76.5 33,65 C33,51 54,30 54,30 Z" />

    <!-- 中间的孔（用背景色的圆挖出来，这里直接画深色圆） -->
    <path
        android:fillColor="#3E7CB4"
        android:pathData="M54,63 m-10,0 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0 Z" />
</vector>
