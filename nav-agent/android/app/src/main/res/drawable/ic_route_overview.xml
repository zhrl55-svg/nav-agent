    <path
        android:fillColor="#F0F2F5"
        android:pathData="M6.5,15.5m-1.5,0a1.5,1.5 0,1 1,3 0a1.5,1.5 0,1 1,-3 0" />

    <!-- 终点方块 -->
    <path
