nav-agent/tools/android/

# ---------------------------------------------------------------------------
# 高德导航 SDK 二进制（187MB）
# jar 36MB + 两个 ABI 的 so 共 151MB，进 Git 会把仓库撑爆。
# 官方没上 Maven（新版本只在官网下载 ZIP），所以走「构建前自动下载」：
#     bash nav-agent/tools/fetch_amap_sdk.sh
# ---------------------------------------------------------------------------
nav-agent/android/libs/amap/

# ---------------------------------------------------------------------------
# 调试截图
# nav-agent/shot*.png 是 80+ 张 UI 调试截图（单张最大 1MB），是过程产物不是源码。
# 需要看界面时直接 adb screencap 取当前屏，不必回溯历史截图。
# ---------------------------------------------------------------------------
nav-agent/shot*.png
nav-agent/nav_*.png

# ---------------------------------------------------------------------------
# sherpa-onnx AAR（47MB）
# 2026-11-04 正式启用：播报期间用它的 KeywordSpotter 做固定关键词识别，
# 声纹 encoder 也换成它的 SpeakerEmbeddingExtractor。
# AAR 只在 GitHub releases 上，官方没上 Maven，构建前跑 tools/fetch_sherpa.sh 拉。
# 脚本里带 sha256 校验。
# ★ KWS 模型本身（app/src/main/assets/sherpa-kws/，约 4.5MB）已经入库 ——
#   上游 release 里的 int8 encoder 和入库这份不是同一个文件，
#   而入库这份是 2026-11-04 在 P40 Pro 上实测能命中的版本。
# ---------------------------------------------------------------------------
nav-agent/android/libs/sherpa/

# ---------------------------------------------------------------------------
# 临时目录（截图、抓取产物等）
# ---------------------------------------------------------------------------
.tmp/

# ---------------------------------------------------------------------------
# 调试脚本的临时产物
# ---------------------------------------------------------------------------
nav-agent/tools/probe_news*.py
nav-agent/tools/tav.json

# ---------------------------------------------------------------------------
# 调试过程产物（2026-11-04）
# ---------------------------------------------------------------------------
nav-agent/.tmp-*.log
nav-agent/android/.tmp-*.log
nav-agent/.tmp-kws-wav/
nav-agent/.tmp-amap-inspect/
nav-agent/p40-*.png
nav-agent/$null

# ---------------------------------------------------------------------------
# 改动前的备份文件（2026-11-05）
